{
  "root": true,
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "commonjs"
  },
  "env": {
    "node": true,
    "jest": true,
    "es2022": true
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "max-len": ["error", { "code": 100, "ignoreUrls": true }],
    "eqeqeq": ["error", "always"],
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
  },
  "ignorePatterns": ["coverage", "node_modules", "jest.config.js"]
}
